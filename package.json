{
  "name": "mood-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "随手记录琐事与心情的移动端小应用（PWA）。打开即可写，保存到本机。",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5181",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=suiji"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
